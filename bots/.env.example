# Network and contracts (defaults shown)
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
SWAP_CONTRACT=fundswap-lab.testnet
COLLATERAL_TOKEN=tusdc.token.primitives.testnet

# Oracle signer secret keys, ed25519:<base58 64 bytes>. Index = position in the contract's signer list.
ORACLE_SIGNER_0=
ORACLE_SIGNER_1=
ORACLE_SIGNER_2=

# Bot accounts. A key may be given as <ROLE>_PRIVATE_KEY; otherwise it is read
# from ~/.near-credentials/<network>/<account>.json.
ORACLE_ACCOUNT=oracle.fundswap-treasury.testnet
MAKER_ACCOUNT=maker.fundswap-treasury.testnet
KEEPER_ACCOUNT=keeper.fundswap-treasury.testnet
TREASURY_ACCOUNT=fundswap-treasury.testnet
# ORACLE_PRIVATE_KEY=
# MAKER_PRIVATE_KEY=
# KEEPER_PRIVATE_KEY=
# TREASURY_PRIVATE_KEY=

# Maker tuning
MAKER_SPREAD_BPS=50
MAKER_SIZE_USDC=25000
MAKER_MAX_INVENTORY_USDC=100000
MAKER_REQUOTE_BPS=25
